# Configure a real published QuickML endpoint; never commit .env.
# AppSail build maps these keys to VOLTIDE_* to avoid platform-reserved names.
QUICKML_ENDPOINT_URL=
QUICKML_ENDPOINT_KEY=
QUICKML_MODEL_VERSION=
QUICKML_FEATURE_VERSION=v1
CATALYST_ORG_ID=
CATALYST_PROJECT_ID=
CATALYST_ENVIRONMENT=Development
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Generate a private random value for hosted browser sessions.
SESSION_SECRET=
# Optional cloud history. Local execution has no Catalyst request-scoped SDK credentials.
CATALYST_RUNS_BUCKET=
CATALYST_RUNS_TABLE=ForecastRuns
